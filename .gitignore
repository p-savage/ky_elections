# Virtual environment: machine-specific; rebuild with
# python3.12 -m venv .venv && pip install -r requirements.txt
/.venv/

# Python bytecode caches, regenerated automatically on import
__pycache__/

# Ruff's lint cache
.ruff_cache/

# Pipeline output: downloaded files, logs, manifests, queues.
# Regenerated by running the pipeline.
/data/

# macOS Finder metadata
.DS_Store